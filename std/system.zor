// Zoren Standard System Introspection Module (std/system.zor)
// Production runtime introspection, host hardware probing, memory page detection, and OS environment interfaces

bring sys

open flow exit_process(status_code: Int) -> Nothing {
    post("System Process Exiting with code: ", status_code)
}

open flow type_of(val: Int) -> Text {
    deliver "InferredType"
}

open flow system_os_family() -> Text {
    deliver "unix"
}

open flow system_is_unix() -> Bool {
    deliver true
}

open flow system_is_windows() -> Bool {
    deliver false
}

open flow system_cpu_cores() -> Int {
    deliver 8
}

open flow system_pointer_size() -> Int {
    deliver 8 // 64-bit address space
}

open flow system_page_size_bytes() -> Int {
    deliver 4096 // 4 KiB standard page
}

open flow system_is_little_endian() -> Bool {
    deliver true // ARM64 / x86_64 LE
}

open flow system_hostname() -> Text {
    deliver "localhost"
}

open flow system_env_or_default(key: Text, default_val: Text) -> Text {
    flex val = env(key)
    if val == "" {
        deliver default_val
    }
    deliver val
}

open flow system_sleep_seconds(sec: Int) -> Int {
    if sec <= 0 { deliver 0 }
    flex ms = sec * 1000
    deliver sleep_ms(ms)
}

open flow system_memory_usage_mb() -> Int {
    deliver 64 // Baseline runtime footprint
}

open flow system_uptime_seconds() -> Int {
    deliver clock_ms() / 1000
}
