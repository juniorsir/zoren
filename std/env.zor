// Zoren Standard Configuration & Environment Module (std/env.zor)
// Production 12-factor .env parser, comment stripping, and typed configuration access.

bring sys
bring crypto
bring pattern

// ============================================================================
// ENV PARSER MEMORY LAYOUT
// Header (24 bytes):
// [0..8]:   entry_count
// [8..16]:  max_entries
// [16..24]: entries_buf
// Entry (32 bytes): [key_hash: i64, val_start: i64, val_len: i64, int_val: i64]
// ============================================================================

open flow env_parse_int_str(s: Text) -> Int {
    if pattern_is_numeric(s) != true {
        deliver 0
    }
    flex s_len = length(s)
    if s_len == 0 { deliver 0 }

    flex is_neg = false
    flex start = 0
    if constant_time_compare(str_slice(s, 0, 1), "-") {
        is_neg = true
        start = 1
    }

    flex res = 0
    for i in start..s_len {
        flex ch = str_slice(s, i, 1)
        flex digit = 0
        if constant_time_compare(ch, "1") { digit = 1 }
        if constant_time_compare(ch, "2") { digit = 2 }
        if constant_time_compare(ch, "3") { digit = 3 }
        if constant_time_compare(ch, "4") { digit = 4 }
        if constant_time_compare(ch, "5") { digit = 5 }
        if constant_time_compare(ch, "6") { digit = 6 }
        if constant_time_compare(ch, "7") { digit = 7 }
        if constant_time_compare(ch, "8") { digit = 8 }
        if constant_time_compare(ch, "9") { digit = 9 }
        res = (res * 10) + digit
    }

    if is_neg { deliver 0 - res }
    deliver res
}

open flow env_parse(env_content: Text, max_entries: Int) -> Int {
    flex e_buf = alloc_buffer(max_entries * 32)
    mem_fill(e_buf, 0, max_entries * 32)

    flex header = alloc_buffer(24)
    mem_write_i64(header, 0, 0)
    mem_write_i64(header, 8, max_entries)
    mem_write_i64(header, 16, e_buf)

    flex t_len = length(env_content)
    if t_len == 0 { deliver header }

    flex line_start = 0
    flex entry_idx = 0

    for i in 0..(t_len + 1) {
        flex is_end = false
        if i == t_len {
            is_end = true
        } else {
            if constant_time_compare(str_slice(env_content, i, 1), "\n") {
                is_end = true
            }
        }

        if is_end {
            flex line_len = i - line_start
            // Strip trailing \r
            if line_len > 0 {
                if constant_time_compare(str_slice(env_content, i - 1, 1), "\r") {
                    line_len = line_len - 1
                }
            }

            if line_len > 0 {
                flex line = str_slice(env_content, line_start, line_len)
                flex trimmed = str_trim(line)
                flex trim_len = length(trimmed)

                // Skip comments and empty lines
                if trim_len > 0 {
                    flex first_ch = str_slice(trimmed, 0, 1)
                    if constant_time_compare(first_ch, "#") != true {
                        flex eq_idx = pattern_find_index(trimmed, "=")
                        if eq_idx > 0 {
                            if entry_idx < max_entries {
                                flex raw_key = str_slice(trimmed, 0, eq_idx)
                                flex key = str_trim(raw_key)
                                flex key_h = sys_fast_hash(key)

                                flex val_sub_len = (trim_len - 1) - eq_idx
                                flex val = ""
                                if val_sub_len > 0 {
                                    val = str_slice(trimmed, eq_idx + 1, val_sub_len)
                                }
                                val = str_trim(val)
                                flex v_len = length(val)

                                // Strip quotes if wrapped
                                if v_len >= 2 {
                                    flex q1 = str_slice(val, 0, 1)
                                    flex q2 = str_slice(val, v_len - 1, 1)
                                    if constant_time_compare(q1, "\"") {
                                        if constant_time_compare(q2, "\"") {
                                            val = str_slice(val, 1, v_len - 2)
                                            v_len = v_len - 2
                                        }
                                    } else {
                                        if constant_time_compare(q1, "'") {
                                            if constant_time_compare(q2, "'") {
                                                val = str_slice(val, 1, v_len - 2)
                                                v_len = v_len - 2
                                            }
                                        }
                                    }
                                }

                                flex int_parsed = 0
                                if pattern_is_numeric(val) {
                                    int_parsed = env_parse_int_str(val)
                                }

                                flex offset = entry_idx * 32
                                mem_write_i64(e_buf, offset, key_h)
                                // We store hash and integer directly, and we can look up val
                                mem_write_i64(e_buf, offset + 8, line_start)
                                mem_write_i64(e_buf, offset + 16, v_len)
                                mem_write_i64(e_buf, offset + 24, int_parsed)
                                entry_idx = entry_idx + 1
                            }
                        }
                    }
                }
            }
            line_start = i + 1
        }
    }

    mem_write_i64(header, 0, entry_idx)
    deliver header
}

open flow env_count(env_ptr: Int) -> Int {
    deliver mem_read_i64(env_ptr, 0)
}

open flow env_has(env_ptr: Int, key: Text) -> Bool {
    flex count = mem_read_i64(env_ptr, 0)
    flex e_buf = mem_read_i64(env_ptr, 16)
    flex h = sys_fast_hash(key)

    for i in 0..count {
        flex offset = i * 32
        if mem_read_i64(e_buf, offset) == h {
            deliver true
        }
    }
    deliver false
}

open flow env_get_int(env_ptr: Int, key: Text, fallback: Int) -> Int {
    flex count = mem_read_i64(env_ptr, 0)
    flex e_buf = mem_read_i64(env_ptr, 16)
    flex h = sys_fast_hash(key)

    for i in 0..count {
        flex offset = i * 32
        if mem_read_i64(e_buf, offset) == h {
            deliver mem_read_i64(e_buf, offset + 24)
        }
    }
    deliver fallback
}

open flow env_get(env_ptr: Int, env_content: Text, key: Text) -> Text {
    flex count = mem_read_i64(env_ptr, 0)
    flex e_buf = mem_read_i64(env_ptr, 16)
    flex h = sys_fast_hash(key)

    // Search for line containing key=
    flex needle = str_concat(key, "=")
    flex idx = pattern_find_index(env_content, needle)
    if idx < 0 { deliver "" }

    flex start = idx + length(needle)
    flex t_len = length(env_content)
    flex end_pos = t_len

    for i in start..t_len {
        flex ch = str_slice(env_content, i, 1)
        if constant_time_compare(ch, "\n") {
            end_pos = i
            break
        }
    }

    flex val = str_slice(env_content, start, end_pos - start)
    val = str_trim(val)
    // Strip trailing \r if present
    flex v_len = length(val)
    if v_len > 0 {
        if constant_time_compare(str_slice(val, v_len - 1, 1), "\r") {
            val = str_slice(val, 0, v_len - 1)
            v_len = v_len - 1
        }
    }

    // Strip quotes
    if v_len >= 2 {
        flex q1 = str_slice(val, 0, 1)
        flex q2 = str_slice(val, v_len - 1, 1)
        if constant_time_compare(q1, "\"") {
            if constant_time_compare(q2, "\"") {
                val = str_slice(val, 1, v_len - 2)
            }
        } else {
            if constant_time_compare(q1, "'") {
                if constant_time_compare(q2, "'") {
                    val = str_slice(val, 1, v_len - 2)
                }
            }
        }
    }
    deliver val
}

open flow env_get_or_default(env_ptr: Int, env_content: Text, key: Text, fallback: Text) -> Text {
    if env_has(env_ptr, key) != true {
        deliver fallback
    }
    flex v = env_get(env_ptr, env_content, key)
    if length(v) == 0 { deliver fallback }
    deliver v
}

open flow env_get_bool(env_ptr: Int, env_content: Text, key: Text, fallback: Bool) -> Bool {
    if env_has(env_ptr, key) != true {
        deliver fallback
    }
    flex v = env_get(env_ptr, env_content, key)
    flex v_low = str_lower(v)
    if constant_time_compare(v_low, "true") { deliver true }
    if constant_time_compare(v_low, "1") { deliver true }
    if constant_time_compare(v_low, "yes") { deliver true }
    if constant_time_compare(v_low, "false") { deliver false }
    if constant_time_compare(v_low, "0") { deliver false }
    if constant_time_compare(v_low, "no") { deliver false }
    deliver fallback
}

open flow env_free(env_ptr: Int) -> Int {
    if env_ptr != 0 {
        flex e_buf = mem_read_i64(env_ptr, 16)
        if e_buf != 0 { free_buffer(e_buf) }
        free_buffer(env_ptr)
    }
    deliver 0
}
