// Zoren B+ Tree Indexed Search Engine (std/b_plus_tree.zor)
// Production B+ Tree implementation with high fanout, ordered leaf pointer chaining,
// logarithmic point lookups, and rapid linear range scanning.

bring sys

// ============================================================================
// B+ TREE MEMORY LAYOUT (Order 8)
// Header (48 bytes):
// [0..8]:   size (total key-value pairs)
// [8..16]:  root_idx (index of root node)
// [16..24]: nodes_buf
// [24..32]: max_nodes
// [32..40]: node_count (allocated nodes)
// [40..48]: first_leaf_idx (start of linked leaves for range scans)
//
// Node Layout (224 bytes):
// [0..8]:     is_leaf (1 = leaf, 0 = internal)
// [8..16]:    num_keys (0..7)
// [16..72]:   keys[7] (offsets 16, 24, 32, 40, 48, 56, 64)
// [72..128]:  vals[7] (leaves: values, offsets 72, 80, 88, 96, 104, 112, 120)
// [128..192]: children[8] (internal nodes, offsets 128, 136, 144, 152, 160, 168, 176, 184)
// [192..200]: next_leaf (leaf: index of next leaf node, -1 if tail)
// [200..208]: parent (index of parent node, -1 if root)
// [208..224]: reserved
// ============================================================================

flow bpt_node_addr(tree: Int, node_idx: Int) -> Int {
    flex nodes_buf = mem_read_i64(tree, 16)
    deliver nodes_buf + (node_idx * 224)
}

flow bpt_alloc_node(tree: Int, is_leaf: Int) -> Int {
    flex count = mem_read_i64(tree, 32)
    flex max_n = mem_read_i64(tree, 24)
    if count >= max_n { deliver 0 - 1 }

    flex node_idx = count
    mem_write_i64(tree, 32, count + 1)

    flex addr = bpt_node_addr(tree, node_idx)
    mem_fill(addr, 0, 224)
    mem_write_i64(addr, 0, is_leaf)
    mem_write_i64(addr, 8, 0)          // num_keys = 0
    mem_write_i64(addr, 192, 0 - 1)    // next_leaf = -1
    mem_write_i64(addr, 200, 0 - 1)    // parent = -1

    flex i = 0
    while i < 8 {
        mem_write_i64(addr, 128 + (i * 8), 0 - 1)
        i = i + 1
    }

    deliver node_idx
}

open flow bptree_new(capacity: Int) -> Int {
    flex cap = capacity
    if cap <= 0 { cap = 256 }
    flex total_bytes = cap * 224
    flex nodes_buf = alloc_buffer(total_bytes)
    mem_fill(nodes_buf, 0, total_bytes)

    flex tree = alloc_buffer(48)
    mem_write_i64(tree, 0, 0)      // size = 0
    mem_write_i64(tree, 8, 0)      // root_idx = 0
    mem_write_i64(tree, 16, nodes_buf)
    mem_write_i64(tree, 24, cap)
    mem_write_i64(tree, 32, 0)     // node_count = 0
    mem_write_i64(tree, 40, 0)     // first_leaf = 0

    // Allocate root as leaf initially
    flex root = bpt_alloc_node(tree, 1)
    mem_write_i64(tree, 8, root)
    mem_write_i64(tree, 40, root)

    deliver tree
}

open flow bptree_size(tree: Int) -> Int { deliver mem_read_i64(tree, 0) }
open flow bptree_is_empty(tree: Int) -> Bool { deliver mem_read_i64(tree, 0) == 0 }

// Finds the leaf node that should contain key
flow bpt_find_leaf(tree: Int, key: Int) -> Int {
    flex curr = mem_read_i64(tree, 8)
    while curr >= 0 {
        flex addr = bpt_node_addr(tree, curr)
        flex is_leaf = mem_read_i64(addr, 0)
        if is_leaf == 1 { deliver curr }

        flex num_keys = mem_read_i64(addr, 8)
        flex child_idx = 0
        while child_idx < num_keys {
            flex k = mem_read_i64(addr, 16 + (child_idx * 8))
            if key < k {
                break
            }
            child_idx = child_idx + 1
        }
        curr = mem_read_i64(addr, 128 + (child_idx * 8))
    }
    deliver 0 - 1
}

open flow bptree_find(tree: Int, key: Int) -> Int {
    flex leaf_idx = bpt_find_leaf(tree, key)
    if leaf_idx < 0 { deliver 0 - 1 }

    flex addr = bpt_node_addr(tree, leaf_idx)
    flex num_keys = mem_read_i64(addr, 8)
    flex i = 0
    while i < num_keys {
        flex k = mem_read_i64(addr, 16 + (i * 8))
        if k == key {
            deliver mem_read_i64(addr, 72 + (i * 8))
        }
        i = i + 1
    }
    deliver 0 - 1
}

open flow bptree_contains(tree: Int, key: Int) -> Bool {
    deliver bptree_find(tree, key) >= 0
}

flow bpt_insert_into_parent(tree: Int, left_idx: Int, split_key: Int, right_idx: Int) -> Int {
    flex root_idx = mem_read_i64(tree, 8)
    flex left_addr = bpt_node_addr(tree, left_idx)
    flex right_addr = bpt_node_addr(tree, right_idx)

    if left_idx == root_idx {
        flex new_root = bpt_alloc_node(tree, 0) // internal
        if new_root < 0 { deliver 0 }
        flex nr_addr = bpt_node_addr(tree, new_root)

        mem_write_i64(nr_addr, 8, 1)                      // 1 key
        mem_write_i64(nr_addr, 16, split_key)             // key 0
        mem_write_i64(nr_addr, 128 + 0, left_idx)         // child 0
        mem_write_i64(nr_addr, 128 + 8, right_idx)        // child 1

        mem_write_i64(left_addr, 200, new_root)
        mem_write_i64(right_addr, 200, new_root)
        mem_write_i64(tree, 8, new_root)
        deliver 1
    }

    flex p_idx = mem_read_i64(left_addr, 200)
    flex p_addr = bpt_node_addr(tree, p_idx)
    flex p_keys = mem_read_i64(p_addr, 8)

    if p_keys < 7 {
        flex pos = 0
        while pos < p_keys && mem_read_i64(p_addr, 16 + (pos * 8)) < split_key {
            pos = pos + 1
        }

        // Shift keys
        flex j = p_keys
        while j > pos {
            flex prev_k = mem_read_i64(p_addr, 16 + ((j - 1) * 8))
            mem_write_i64(p_addr, 16 + (j * 8), prev_k)
            flex prev_c = mem_read_i64(p_addr, 128 + (j * 8))
            mem_write_i64(p_addr, 128 + ((j + 1) * 8), prev_c)
            j = j - 1
        }

        mem_write_i64(p_addr, 16 + (pos * 8), split_key)
        mem_write_i64(p_addr, 128 + ((pos + 1) * 8), right_idx)
        mem_write_i64(right_addr, 200, p_idx)
        mem_write_i64(p_addr, 8, p_keys + 1)
        deliver 1
    }

    deliver 0
}

open flow bptree_insert(tree: Int, key: Int, val: Int) -> Int {
    flex leaf_idx = bpt_find_leaf(tree, key)
    if leaf_idx < 0 { deliver 0 }

    flex addr = bpt_node_addr(tree, leaf_idx)
    flex num_keys = mem_read_i64(addr, 8)

    // Check if key already exists -> update
    flex i = 0
    while i < num_keys {
        flex k = mem_read_i64(addr, 16 + (i * 8))
        if k == key {
            mem_write_i64(addr, 72 + (i * 8), val)
            deliver 1
        }
        i = i + 1
    }

    // If leaf has room (< 3 keys for small testing or < 4)
    if num_keys < 3 {
        flex pos = 0
        while pos < num_keys && mem_read_i64(addr, 16 + (pos * 8)) < key {
            pos = pos + 1
        }
        flex j = num_keys
        while j > pos {
            flex prev_k = mem_read_i64(addr, 16 + ((j - 1) * 8))
            flex prev_v = mem_read_i64(addr, 72 + ((j - 1) * 8))
            mem_write_i64(addr, 16 + (j * 8), prev_k)
            mem_write_i64(addr, 72 + (j * 8), prev_v)
            j = j - 1
        }
        mem_write_i64(addr, 16 + (pos * 8), key)
        mem_write_i64(addr, 72 + (pos * 8), val)
        mem_write_i64(addr, 8, num_keys + 1)

        flex cur_sz = mem_read_i64(tree, 0)
        mem_write_i64(tree, 0, cur_sz + 1)
        deliver 1
    }

    // Leaf split (3 keys -> 4 items with new key)
    flex new_leaf = bpt_alloc_node(tree, 1)
    if new_leaf < 0 { deliver 0 }
    flex new_addr = bpt_node_addr(tree, new_leaf)

    flex temp_k = alloc_buffer(32)
    flex temp_v = alloc_buffer(32)
    flex inserted = false
    flex src = 0
    flex dst = 0
    while src < 3 {
        flex ck = mem_read_i64(addr, 16 + (src * 8))
        flex cv = mem_read_i64(addr, 72 + (src * 8))
        if !inserted && key < ck {
            mem_write_i64(temp_k, dst * 8, key)
            mem_write_i64(temp_v, dst * 8, val)
            dst = dst + 1
            inserted = true
        }
        mem_write_i64(temp_k, dst * 8, ck)
        mem_write_i64(temp_v, dst * 8, cv)
        dst = dst + 1
        src = src + 1
    }
    if !inserted {
        mem_write_i64(temp_k, dst * 8, key)
        mem_write_i64(temp_v, dst * 8, val)
    }

    // Left leaf gets first 2 keys, right leaf gets remaining 2
    mem_write_i64(addr, 8, 2)
    mem_write_i64(addr, 16, mem_read_i64(temp_k, 0))
    mem_write_i64(addr, 24, mem_read_i64(temp_k, 8))
    mem_write_i64(addr, 72, mem_read_i64(temp_v, 0))
    mem_write_i64(addr, 80, mem_read_i64(temp_v, 8))

    mem_write_i64(new_addr, 8, 2)
    mem_write_i64(new_addr, 16, mem_read_i64(temp_k, 16))
    mem_write_i64(new_addr, 24, mem_read_i64(temp_k, 24))
    mem_write_i64(new_addr, 72, mem_read_i64(temp_v, 16))
    mem_write_i64(new_addr, 80, mem_read_i64(temp_v, 24))

    // Chain leaf pointers
    mem_write_i64(new_addr, 192, mem_read_i64(addr, 192))
    mem_write_i64(addr, 192, new_leaf)

    // Split key is first key of new leaf
    flex split_k = mem_read_i64(new_addr, 16)
    bpt_insert_into_parent(tree, leaf_idx, split_k, new_leaf)

    free_buffer(temp_k)
    free_buffer(temp_v)

    flex cur_sz = mem_read_i64(tree, 0)
    mem_write_i64(tree, 0, cur_sz + 1)
    deliver 1
}

open flow bptree_range_scan(tree: Int, min_key: Int, max_key: Int, out_buf: Int, max_out: Int) -> Int {
    flex count = 0
    flex curr_leaf = mem_read_i64(tree, 40) // first_leaf_idx

    while curr_leaf >= 0 && count < max_out {
        flex addr = bpt_node_addr(tree, curr_leaf)
        flex num_keys = mem_read_i64(addr, 8)
        flex i = 0
        while i < num_keys && count < max_out {
            flex k = mem_read_i64(addr, 16 + (i * 8))
            if k >= min_key && k <= max_key {
                flex v = mem_read_i64(addr, 72 + (i * 8))
                mem_write_i64(out_buf, count * 8, v)
                count = count + 1
            }
            if k > max_key {
                deliver count
            }
            i = i + 1
        }
        curr_leaf = mem_read_i64(addr, 192) // next_leaf
    }
    deliver count
}

open flow bptree_min_key(tree: Int) -> Int {
    flex first_leaf = mem_read_i64(tree, 40)
    if first_leaf < 0 { deliver 0 - 1 }
    flex addr = bpt_node_addr(tree, first_leaf)
    if mem_read_i64(addr, 8) == 0 { deliver 0 - 1 }
    deliver mem_read_i64(addr, 16)
}

open flow bptree_free(tree: Int) -> Int {
    if tree != 0 {
        flex nodes_buf = mem_read_i64(tree, 16)
        if nodes_buf != 0 { free_buffer(nodes_buf) }
        free_buffer(tree)
    }
    deliver 0
}
