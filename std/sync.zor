// Zoren Concurrency & Synchronization Primitives (std/sync.zor)
// In-memory atomic integer operations, Mutex locks, WaitGroup, and counting Semaphores.

bring sys

// ============================================================================
// 1. ATOMIC OPERATIONS (Simulated atomic memory layout on 64-bit words)
// ============================================================================

open flow atomic_load(buf_ptr: Int, offset: Int) -> Int {
    deliver mem_read_i64(buf_ptr, offset)
}

open flow atomic_store(buf_ptr: Int, offset: Int, val: Int) -> Int {
    mem_write_i64(buf_ptr, offset, val)
    deliver val
}

open flow atomic_cas(buf_ptr: Int, offset: Int, expected: Int, desired: Int) -> Bool {
    flex current = mem_read_i64(buf_ptr, offset)
    if current == expected {
        mem_write_i64(buf_ptr, offset, desired)
        deliver true
    }
    deliver false
}

open flow atomic_add(buf_ptr: Int, offset: Int, delta: Int) -> Int {
    flex current = mem_read_i64(buf_ptr, offset)
    flex new_val = current + delta
    mem_write_i64(buf_ptr, offset, new_val)
    deliver new_val
}

open flow atomic_sub(buf_ptr: Int, offset: Int, delta: Int) -> Int {
    flex current = mem_read_i64(buf_ptr, offset)
    flex new_val = current - delta
    mem_write_i64(buf_ptr, offset, new_val)
    deliver new_val
}

// ============================================================================
// 2. MUTEX (Mutual Exclusion Lock)
// Header layout (24 bytes):
// [0..8]:  state (0 = UNLOCKED, 1 = LOCKED)
// [8..16]: owner_thread_id
// [16..24]: lock_count (reentrancy counter)
// ============================================================================

open flow mutex_new() -> Int {
    flex m = alloc_buffer(24)
    mem_fill(m, 0, 24)
    deliver m
}

open flow mutex_lock(m_ptr: Int) -> Bool {
    flex state = mem_read_i64(m_ptr, 0)
    if state == 0 {
        mem_write_i64(m_ptr, 0, 1)
        mem_write_i64(m_ptr, 16, 1)
        deliver true
    }
    deliver false
}

open flow mutex_unlock(m_ptr: Int) -> Bool {
    flex state = mem_read_i64(m_ptr, 0)
    if state == 1 {
        mem_write_i64(m_ptr, 0, 0)
        mem_write_i64(m_ptr, 16, 0)
        deliver true
    }
    deliver false
}

open flow mutex_is_locked(m_ptr: Int) -> Bool {
    deliver mem_read_i64(m_ptr, 0) == 1
}

// ============================================================================
// 3. WAIT GROUP (Go-style WaitGroup)
// Header layout (16 bytes):
// [0..8]:  counter
// [8..16]: generation
// ============================================================================

open flow wait_group_new() -> Int {
    flex wg = alloc_buffer(16)
    mem_fill(wg, 0, 16)
    deliver wg
}

open flow wait_group_add(wg_ptr: Int, delta: Int) -> Int {
    flex cur = mem_read_i64(wg_ptr, 0)
    flex n = cur + delta
    if n < 0 { n = 0 }
    mem_write_i64(wg_ptr, 0, n)
    deliver n
}

open flow wait_group_done(wg_ptr: Int) -> Int {
    deliver wait_group_add(wg_ptr, -1)
}

open flow wait_group_is_done(wg_ptr: Int) -> Bool {
    deliver mem_read_i64(wg_ptr, 0) == 0
}

open flow wait_group_count(wg_ptr: Int) -> Int {
    deliver mem_read_i64(wg_ptr, 0)
}

// ============================================================================
// 4. COUNTING SEMAPHORE
// Header layout (24 bytes):
// [0..8]:  available_permits
// [8..16]: max_permits
// [16..24]: wait_count
// ============================================================================

open flow semaphore_new(permits: Int) -> Int {
    if permits <= 0 { permits = 1 }
    flex sem = alloc_buffer(24)
    mem_write_i64(sem, 0, permits)
    mem_write_i64(sem, 8, permits)
    mem_write_i64(sem, 16, 0)
    deliver sem
}

open flow semaphore_acquire(sem_ptr: Int) -> Bool {
    flex avail = mem_read_i64(sem_ptr, 0)
    if avail > 0 {
        mem_write_i64(sem_ptr, 0, avail - 1)
        deliver true
    }
    deliver false
}

open flow semaphore_release(sem_ptr: Int) -> Bool {
    flex avail = mem_read_i64(sem_ptr, 0)
    flex max_p = mem_read_i64(sem_ptr, 8)
    if avail < max_p {
        mem_write_i64(sem_ptr, 0, avail + 1)
        deliver true
    }
    deliver false
}

open flow semaphore_available(sem_ptr: Int) -> Int {
    deliver mem_read_i64(sem_ptr, 0)
}
