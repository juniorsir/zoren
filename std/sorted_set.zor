// Zoren High-Performance Scored Sorted Set (std/sorted_set.zor)
// Redis-style ZSET supporting scored indexing, ranking, range queries, and fast lookups.

bring sys
bring crypto

// ============================================================================
// SORTED SET MEMORY LAYOUT
// Header (32 bytes):
// [0..8]:   count     (total active members)
// [8..16]:  capacity  (max entries)
// [16..24]: table_ptr (table of capacity * 32 bytes)
// [24..32]: total_slots_used
//
// Each Entry (32 bytes):
// [0..8]:   member_hash (sys_fast_hash of member)
// [8..16]:  score       (int64 score)
// [16..24]: is_active   (1 = active, 0 = inactive)
// [24..32]: reserved
// ============================================================================

open flow zset_new(capacity: Int) -> Int {
    if capacity <= 0 { capacity = 128 }
    flex entry_size = 32
    flex table = alloc_buffer(capacity * entry_size)
    mem_fill(table, 0, capacity * entry_size)

    flex header = alloc_buffer(32)
    mem_write_i64(header, 0, 0)        // count = 0
    mem_write_i64(header, 8, capacity) // capacity
    mem_write_i64(header, 16, table)   // table_ptr
    mem_write_i64(header, 24, 0)       // total_slots_used = 0

    deliver header
}

open flow zset_count(zset_ptr: Int) -> Int {
    deliver mem_read_i64(zset_ptr, 0)
}

open flow zset_find_slot(zset_ptr: Int, member: Text) -> Int {
    flex m_hash = sys_fast_hash(member)
    flex total_slots = mem_read_i64(zset_ptr, 24)
    flex table = mem_read_i64(zset_ptr, 16)

    for i in 0..total_slots {
        flex offset = i * 32
        flex is_act = mem_read_i64(table, offset + 16)
        if is_act == 1 {
            flex h = mem_read_i64(table, offset)
            if h == m_hash {
                deliver i
            }
        }
    }
    deliver -1
}

open flow zset_add(zset_ptr: Int, member: Text, score: Int) -> Bool {
    flex existing_slot = zset_find_slot(zset_ptr, member)
    flex table = mem_read_i64(zset_ptr, 16)

    if existing_slot >= 0 {
        // Update existing member's score
        flex offset = existing_slot * 32
        mem_write_i64(table, offset + 8, score)
        deliver true
    }

    // Insert new member
    flex cap = mem_read_i64(zset_ptr, 8)
    flex total_slots = mem_read_i64(zset_ptr, 24)
    if total_slots >= cap { deliver false }

    flex new_offset = total_slots * 32
    mem_write_i64(table, new_offset, sys_fast_hash(member))
    mem_write_i64(table, new_offset + 8, score)
    mem_write_i64(table, new_offset + 16, 1) // active
    mem_write_i64(table, new_offset + 24, 0)

    flex cur_count = mem_read_i64(zset_ptr, 0)
    mem_write_i64(zset_ptr, 0, cur_count + 1)
    mem_write_i64(zset_ptr, 24, total_slots + 1)

    deliver true
}

open flow zset_score(zset_ptr: Int, member: Text) -> Int {
    flex slot = zset_find_slot(zset_ptr, member)
    if slot < 0 { deliver -999999999 }
    flex table = mem_read_i64(zset_ptr, 16)
    deliver mem_read_i64(table, (slot * 32) + 8)
}

open flow zset_rank(zset_ptr: Int, member: Text) -> Int {
    flex slot = zset_find_slot(zset_ptr, member)
    if slot < 0 { deliver -1 }

    flex table = mem_read_i64(zset_ptr, 16)
    flex my_score = mem_read_i64(table, (slot * 32) + 8)
    flex my_hash = mem_read_i64(table, slot * 32)
    flex total_slots = mem_read_i64(zset_ptr, 24)

    flex rank = 0
    for i in 0..total_slots {
        flex offset = i * 32
        flex is_act = mem_read_i64(table, offset + 16)
        if is_act == 1 {
            flex other_score = mem_read_i64(table, offset + 8)
            if other_score < my_score {
                rank = rank + 1
            } else if other_score == my_score {
                flex other_hash = mem_read_i64(table, offset)
                if other_hash < my_hash {
                    rank = rank + 1
                }
            }
        }
    }
    deliver rank
}

open flow zset_rem(zset_ptr: Int, member: Text) -> Bool {
    flex slot = zset_find_slot(zset_ptr, member)
    if slot < 0 { deliver false }

    flex table = mem_read_i64(zset_ptr, 16)
    mem_write_i64(table, (slot * 32) + 16, 0) // mark inactive

    flex cur_count = mem_read_i64(zset_ptr, 0)
    mem_write_i64(zset_ptr, 0, cur_count - 1)
    deliver true
}

open flow zset_count_range(zset_ptr: Int, min_score: Int, max_score: Int) -> Int {
    flex total_slots = mem_read_i64(zset_ptr, 24)
    flex table = mem_read_i64(zset_ptr, 16)

    flex in_range = 0
    for i in 0..total_slots {
        flex offset = i * 32
        flex is_act = mem_read_i64(table, offset + 16)
        if is_act == 1 {
            flex sc = mem_read_i64(table, offset + 8)
            if sc >= min_score && sc <= max_score {
                in_range = in_range + 1
            }
        }
    }
    deliver in_range
}
