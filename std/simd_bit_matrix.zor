// Zoren Dense 64x64 SIMD Bit Matrix Suite (std/simd_bit_matrix.zor)
// Production 64x64 bit matrix for binary relations, graph reachability, and bitwise algebra.
// Supports fast transposition, boolean matrix multiplication, and Roy-Warshall transitive closure.

bring sys

// ============================================================================
// BIT MATRIX MEMORY LAYOUT
// Header (32 bytes):
// [0..8]:   rows = 64
// [8..16]:  cols = 64
// [16..24]: buf (4096 bytes, 64 rows * 64 cols)
// [24..32]: reserved
// ============================================================================

open flow bitmat_new() -> Int {
    flex cell_count = 64 * 64
    flex buf = alloc_buffer(cell_count)
    mem_fill(buf, 0, cell_count)

    flex header = alloc_buffer(32)
    mem_write_i64(header, 0, 64)
    mem_write_i64(header, 8, 64)
    mem_write_i64(header, 16, buf)
    mem_write_i64(header, 24, 0)

    deliver header
}

open flow bitmat_rows(m: Int) -> Int {
    deliver mem_read_i64(m, 0)
}

open flow bitmat_cols(m: Int) -> Int {
    deliver mem_read_i64(m, 8)
}

open flow bitmat_get(m: Int, r: Int, c: Int) -> Bool {
    if r < 0 || r >= 64 || c < 0 || c >= 64 { deliver false }
    flex buf = mem_read_i64(m, 16)
    flex byte_val = mem_read_byte(buf, r * 64 + c)
    deliver byte_val != 0
}

open flow bitmat_set(m: Int, r: Int, c: Int, val: Bool) -> Int {
    if r < 0 || r >= 64 || c < 0 || c >= 64 { deliver 0 }
    flex buf = mem_read_i64(m, 16)
    flex b = 0
    if val { b = 1 }
    mem_write_byte(buf, r * 64 + c, b)
    deliver 0
}

open flow bitmat_toggle(m: Int, r: Int, c: Int) -> Int {
    if r < 0 || r >= 64 || c < 0 || c >= 64 { deliver 0 }
    flex buf = mem_read_i64(m, 16)
    flex cur = mem_read_byte(buf, r * 64 + c)
    flex nxt = 1
    if cur != 0 { nxt = 0 }
    mem_write_byte(buf, r * 64 + c, nxt)
    deliver 0
}

open flow bitmat_fill(m: Int, val: Bool) -> Int {
    flex buf = mem_read_i64(m, 16)
    flex b = 0
    if val { b = 1 }
    mem_fill(buf, b, 4096)
    deliver 0
}

open flow bitmat_clear(m: Int) -> Int {
    flex buf = mem_read_i64(m, 16)
    mem_fill(buf, 0, 4096)
    deliver 0
}

open flow bitmat_row_popcount(m: Int, r: Int) -> Int {
    if r < 0 || r >= 64 { deliver 0 }
    flex buf = mem_read_i64(m, 16)
    flex base = r * 64
    flex count = 0
    flex c = 0
    while c < 64 {
        if mem_read_byte(buf, base + c) != 0 {
            count = count + 1
        }
        c = c + 1
    }
    deliver count
}

open flow bitmat_col_popcount(m: Int, col: Int) -> Int {
    if col < 0 || col >= 64 { deliver 0 }
    flex buf = mem_read_i64(m, 16)
    flex count = 0
    flex r = 0
    while r < 64 {
        if mem_read_byte(buf, r * 64 + col) != 0 {
            count = count + 1
        }
        r = r + 1
    }
    deliver count
}

open flow bitmat_total_popcount(m: Int) -> Int {
    flex buf = mem_read_i64(m, 16)
    flex count = 0
    flex i = 0
    while i < 4096 {
        if mem_read_byte(buf, i) != 0 {
            count = count + 1
        }
        i = i + 1
    }
    deliver count
}

open flow bitmat_transpose(m: Int) -> Int {
    flex res = bitmat_new()
    flex src_buf = mem_read_i64(m, 16)
    flex dst_buf = mem_read_i64(res, 16)

    flex r = 0
    while r < 64 {
        flex c = 0
        while c < 64 {
            flex b = mem_read_byte(src_buf, r * 64 + c)
            if b != 0 {
                mem_write_byte(dst_buf, c * 64 + r, 1)
            }
            c = c + 1
        }
        r = r + 1
    }

    deliver res
}

open flow bitmat_and(a: Int, b: Int) -> Int {
    flex res = bitmat_new()
    flex a_buf = mem_read_i64(a, 16)
    flex b_buf = mem_read_i64(b, 16)
    flex dst_buf = mem_read_i64(res, 16)

    flex i = 0
    while i < 4096 {
        if mem_read_byte(a_buf, i) != 0 && mem_read_byte(b_buf, i) != 0 {
            mem_write_byte(dst_buf, i, 1)
        }
        i = i + 1
    }
    deliver res
}

open flow bitmat_or(a: Int, b: Int) -> Int {
    flex res = bitmat_new()
    flex a_buf = mem_read_i64(a, 16)
    flex b_buf = mem_read_i64(b, 16)
    flex dst_buf = mem_read_i64(res, 16)

    flex i = 0
    while i < 4096 {
        if mem_read_byte(a_buf, i) != 0 || mem_read_byte(b_buf, i) != 0 {
            mem_write_byte(dst_buf, i, 1)
        }
        i = i + 1
    }
    deliver res
}

open flow bitmat_xor(a: Int, b: Int) -> Int {
    flex res = bitmat_new()
    flex a_buf = mem_read_i64(a, 16)
    flex b_buf = mem_read_i64(b, 16)
    flex dst_buf = mem_read_i64(res, 16)

    flex i = 0
    while i < 4096 {
        flex ba = mem_read_byte(a_buf, i) != 0
        flex bb = mem_read_byte(b_buf, i) != 0
        if (ba && !bb) || (!ba && bb) {
            mem_write_byte(dst_buf, i, 1)
        }
        i = i + 1
    }
    deliver res
}

open flow bitmat_transitive_closure(m: Int) -> Int {
    // Roy-Warshall algorithm for reachability in directed graphs
    flex res = bitmat_new()
    flex src_buf = mem_read_i64(m, 16)
    flex dst_buf = mem_read_i64(res, 16)

    // Copy initial matrix
    mem_copy(dst_buf, src_buf, 4096)

    flex k = 0
    while k < 64 {
        flex i = 0
        while i < 64 {
            if mem_read_byte(dst_buf, i * 64 + k) != 0 {
                flex j = 0
                while j < 64 {
                    if mem_read_byte(dst_buf, k * 64 + j) != 0 {
                        mem_write_byte(dst_buf, i * 64 + j, 1)
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        k = k + 1
    }

    deliver res
}

open flow bitmat_has_path(tc: Int, from_node: Int, to_node: Int) -> Bool {
    deliver bitmat_get(tc, from_node, to_node)
}
