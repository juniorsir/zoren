// Secure In-Memory Secret Vault with Access-Count Limits, Temporal Expiry & Zeroization
// Enterprise protection for private keys, sensitive tokens, and transient auth credentials

// Secret Slot (40 bytes):
// [0..8]:   secret_id (Int, -1 if free)
// [8..16]:  secret_val (Int)
// [16..24]: max_reads (Int, -1 for unlimited)
// [24..32]: read_count (Int)
// [32..40]: expires_at (Int timestamp, -1 for permanent)

// Header (32 bytes):
// [0..8]:   capacity
// [8..16]:  secret_count
// [16..24]: slots_buf
// [24..32]: total_zeroized

open flow vault_create(capacity: Int) -> Int {
    flex cap = capacity
    if cap < 4 {
        cap = 4
    }
    flex slots = alloc_buffer(cap * 40)
    flex header = alloc_buffer(32)

    flex i = 0
    while i < cap {
        mem_write_i64(slots, i * 40 + 0, -1) // Free
        mem_write_i64(slots, i * 40 + 8, 0)
        mem_write_i64(slots, i * 40 + 16, -1)
        mem_write_i64(slots, i * 40 + 24, 0)
        mem_write_i64(slots, i * 40 + 32, -1)
        i = i + 1
    }

    mem_write_i64(header, 0, cap)
    mem_write_i64(header, 8, 0)  // secret_count
    mem_write_i64(header, 16, slots)
    mem_write_i64(header, 24, 0) // total_zeroized

    deliver header
}

open flow vault_active_count(vault: Int) -> Int {
    deliver mem_read_i64(vault, 8)
}

open flow vault_store(vault: Int, secret_id: Int, secret_val: Int, max_reads: Int, ttl_sec: Int, now_sec: Int) -> Bool {
    flex cap = mem_read_i64(vault, 0)
    flex slots = mem_read_i64(vault, 16)

    flex free_idx = -1
    flex i = 0
    while i < cap {
        if free_idx == -1 {
            flex sid = mem_read_i64(slots, i * 40 + 0)
            if sid == -1 {
                free_idx = i
            }
        }
        i = i + 1
    }

    if free_idx == -1 {
        deliver false // Vault capacity exceeded
    }

    flex exp = -1
    if ttl_sec > 0 {
        exp = now_sec + ttl_sec
    }

    mem_write_i64(slots, free_idx * 40 + 0, secret_id)
    mem_write_i64(slots, free_idx * 40 + 8, secret_val)
    mem_write_i64(slots, free_idx * 40 + 16, max_reads)
    mem_write_i64(slots, free_idx * 40 + 24, 0) // read_count
    mem_write_i64(slots, free_idx * 40 + 32, exp)

    flex count = mem_read_i64(vault, 8)
    mem_write_i64(vault, 8, count + 1)
    deliver true
}

open flow vault_read(vault: Int, secret_id: Int, now_sec: Int) -> Int {
    flex cap = mem_read_i64(vault, 0)
    flex slots = mem_read_i64(vault, 16)

    flex i = 0
    while i < cap {
        flex sid = mem_read_i64(slots, i * 40 + 0)
        if sid == secret_id {
            // Check expiry
            flex exp = mem_read_i64(slots, i * 40 + 32)
            if exp != -1 && now_sec >= exp {
                // Expired: zeroize immediately
                vault_zeroize_slot(vault, i)
                deliver -1
            }

            // Check read limit
            flex max_r = mem_read_i64(slots, i * 40 + 16)
            flex r_cnt = mem_read_i64(slots, i * 40 + 24)
            if max_r != -1 && r_cnt >= max_r {
                // Burn limit reached: zeroize
                vault_zeroize_slot(vault, i)
                deliver -1
            }

            flex val = mem_read_i64(slots, i * 40 + 8)
            r_cnt = r_cnt + 1
            mem_write_i64(slots, i * 40 + 24, r_cnt)

            // If burn limit reached after this read, zeroize
            if max_r != -1 && r_cnt >= max_r {
                vault_zeroize_slot(vault, i)
            }

            deliver val
        }
        i = i + 1
    }

    deliver -1 // Not found
}

open flow vault_zeroize_slot(vault: Int, slot_idx: Int) -> Int {
    flex slots = mem_read_i64(vault, 16)
    // Cryptographically scrub slot memory
    mem_write_i64(slots, slot_idx * 40 + 0, -1)
    mem_write_i64(slots, slot_idx * 40 + 8, 0)
    mem_write_i64(slots, slot_idx * 40 + 16, -1)
    mem_write_i64(slots, slot_idx * 40 + 24, 0)
    mem_write_i64(slots, slot_idx * 40 + 32, -1)

    flex count = mem_read_i64(vault, 8)
    if count > 0 {
        mem_write_i64(vault, 8, count - 1)
    }
    flex zeroized = mem_read_i64(vault, 24)
    mem_write_i64(vault, 24, zeroized + 1)
    deliver 0
}

open flow vault_revoke(vault: Int, secret_id: Int) -> Bool {
    flex cap = mem_read_i64(vault, 0)
    flex slots = mem_read_i64(vault, 16)

    flex i = 0
    while i < cap {
        flex sid = mem_read_i64(slots, i * 40 + 0)
        if sid == secret_id {
            vault_zeroize_slot(vault, i)
            deliver true
        }
        i = i + 1
    }
    deliver false
}

open flow vault_evict_expired(vault: Int, now_sec: Int) -> Int {
    flex cap = mem_read_i64(vault, 0)
    flex slots = mem_read_i64(vault, 16)

    flex evicted = 0
    flex i = 0
    while i < cap {
        flex sid = mem_read_i64(slots, i * 40 + 0)
        if sid != -1 {
            flex exp = mem_read_i64(slots, i * 40 + 32)
            if exp != -1 && now_sec >= exp {
                vault_zeroize_slot(vault, i)
                evicted = evicted + 1
            }
        }
        i = i + 1
    }

    deliver evicted
}

open flow vault_free(vault: Int) -> Int {
    flex cap = mem_read_i64(vault, 0)
    flex slots = mem_read_i64(vault, 16)
    // Zeroize entire buffer before free
    flex i = 0
    while i < cap * 40 {
        mem_write_byte(slots, i, 0)
        i = i + 1
    }
    free_buffer(slots)
    free_buffer(vault)
    deliver 0
}
