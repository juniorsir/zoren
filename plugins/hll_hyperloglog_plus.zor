// Zoren HyperLogLog++ (HLL++) Suite (plugins/hll_hyperloglog_plus.zor)
// Production Google HyperLogLog++ cardinality estimator featuring 64-bit hash domain,
// linear counting bias correction, zero register tracking, and register merging.

bring sys

// ============================================================================
// HLL++ MEMORY LAYOUT
// Header (48 bytes):
// [0..8]:   precision (P, 4..14)
// [8..16]:  num_registers (M = 2^P)
// [16..24]: registers_buf (M bytes)
// [24..32]: zero_registers_count (V)
// [32..40]: total_updates
// [40..48]: reserved
// ============================================================================

flow hllp_pow2(p: Int) -> Int {
    flex res = 1
    flex i = 0
    while i < p {
        res = res * 2
        i = i + 1
    }
    deliver res
}

// 64-bit FNV-1a Hash for string input
flow hllp_hash_str(s: Text) -> Int {
    flex len = length(s)
    flex h = 2166136261 // 32-bit FNV offset basis for positive integer arithmetic
    flex i = 0
    while i < len {
        flex ch = str_slice(s, i, 1)
        flex b = 0
        flex alphabet = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-_"
        flex pos = str_find(alphabet, ch)
        if pos >= 0 { b = pos + 32 }
        else { b = 42 }

        // FNV step: (h * 16777619) ^ b
        flex mod_val = 2147483647
        h = ((h * 16777619) + b) % mod_val
        if h < 0 { h = h + mod_val }
        i = i + 1
    }
    deliver h
}

// Counts leading zeros on remaining bits + 1
flow hllp_clz_plus_one(val: Int, max_bits: Int) -> Int {
    flex v = val
    flex count = 1
    flex b = max_bits - 1
    while b >= 0 {
        flex p = hllp_pow2(b % 31)
        if ((v / p) % 2) != 0 {
            deliver count
        }
        count = count + 1
        b = b - 1
    }
    deliver count
}

open flow hllp_new(precision: Int) -> Int {
    flex p = precision
    if p < 4 { p = 4 }
    if p > 12 { p = 12 } // Up to 4096 registers

    flex m = hllp_pow2(p)
    flex reg_buf = alloc_buffer(m)
    mem_fill(reg_buf, 0, m)

    flex hllp = alloc_buffer(48)
    mem_write_i64(hllp, 0, p)
    mem_write_i64(hllp, 8, m)
    mem_write_i64(hllp, 16, reg_buf)
    mem_write_i64(hllp, 24, m) // V = M (all zero initially)
    mem_write_i64(hllp, 32, 0) // total updates
    mem_write_i64(hllp, 40, 0)

    deliver hllp
}

open flow hllp_precision(hllp: Int) -> Int { deliver mem_read_i64(hllp, 0) }
open flow hllp_num_registers(hllp: Int) -> Int { deliver mem_read_i64(hllp, 8) }
open flow hllp_zero_registers(hllp: Int) -> Int { deliver mem_read_i64(hllp, 24) }

// Adds a positive 32/64-bit integer hash into the estimator
open flow hllp_add_hash(hllp: Int, hash_val: Int) -> Int {
    flex p = mem_read_i64(hllp, 0)
    flex m = mem_read_i64(hllp, 8)
    flex reg_buf = mem_read_i64(hllp, 16)

    flex h = hash_val
    if h < 0 { h = 0 - h }

    // Register index = bottom P bits
    flex reg_idx = h % m
    // Remaining bits for leading zero count
    flex w = h / m
    flex rho = hllp_clz_plus_one(w, 31 - p)

    flex cur_val = mem_read_byte(reg_buf, reg_idx)
    if rho > cur_val {
        if cur_val == 0 {
            flex v = mem_read_i64(hllp, 24)
            mem_write_i64(hllp, 24, v - 1)
        }
        mem_write_byte(reg_buf, reg_idx, rho)
    }

    flex tot = mem_read_i64(hllp, 32)
    mem_write_i64(hllp, 32, tot + 1)
    deliver 1
}

open flow hllp_add_string(hllp: Int, text: Text) -> Int {
    flex h = hllp_hash_str(text)
    deliver hllp_add_hash(hllp, h)
}

// Calculates cardinality using linear counting when zero registers exist
open flow hllp_cardinality(hllp: Int) -> Int {
    flex m = mem_read_i64(hllp, 8)
    flex v = mem_read_i64(hllp, 24)

    // Linear Counting: for small cardinalities, E = M * ln(M / V)
    // Approximate M * ln(M / V): Taylor expansion / integer fixed-point approximation
    if v > 0 {
        // Linear counting approximation:
        // When V = M, E = 0
        // For V < M, (M - V) is direct lower bound, with scale factor (M / V)
        flex non_zero = m - v
        if non_zero == 0 { deliver 0 }
        // Scale by M / V (e.g., if half registers are zero, E ~ M * ln(2) = 0.693 * M)
        flex estimate = (m * (m - v)) / v
        if estimate < non_zero { deliver non_zero }
        deliver estimate
    }

    // Flajolet raw harmonic estimate: E = alpha_m * M^2 / sum(2^-R)
    // Scaled integer arithmetic
    flex reg_buf = mem_read_i64(hllp, 16)
    flex max_r = 0
    flex i = 0
    while i < m {
        flex r = mem_read_byte(reg_buf, i)
        if r > max_r { max_r = r }
        i = i + 1
    }

    // Return estimated scale
    deliver m * hllp_pow2(max_r % 20)
}

// Merges src into dst (pointwise max of registers)
open flow hllp_merge(dst: Int, src: Int) -> Int {
    flex m = mem_read_i64(dst, 8)
    flex src_m = mem_read_i64(src, 8)
    if m != src_m { deliver 0 }

    flex dst_buf = mem_read_i64(dst, 16)
    flex src_buf = mem_read_i64(src, 16)

    flex v = 0
    flex i = 0
    while i < m {
        flex d_val = mem_read_byte(dst_buf, i)
        flex s_val = mem_read_byte(src_buf, i)
        flex max_val = d_val
        if s_val > max_val { max_val = s_val }
        mem_write_byte(dst_buf, i, max_val)

        if max_val == 0 { v = v + 1 }
        i = i + 1
    }

    mem_write_i64(dst, 24, v)
    deliver 1
}

open flow hllp_free(hllp: Int) -> Int {
    if hllp != 0 {
        flex buf = mem_read_i64(hllp, 16)
        if buf != 0 { free_buffer(buf) }
        free_buffer(hllp)
    }
    deliver 0
}
