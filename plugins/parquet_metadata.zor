// Zoren Apache Parquet Metadata Parser Suite (plugins/parquet_metadata.zor)
// Production columnar file footer inspector: PAR1 magic validation, 4-byte footer length extraction,
// row group statistics calculation, and schema column descriptor indexing.

bring sys

// Hex decoding helpers
flow pq_hex_digit(hex_str: Text, idx: Int) -> Int {
    if idx < 0 || idx >= length(hex_str) { deliver 0 }
    flex ch = str_slice(hex_str, idx, 1)
    flex digits = "0123456789abcdef"
    flex pos = str_find(digits, ch)
    if pos >= 0 { deliver pos }
    flex upper = "ABCDEF"
    flex u_pos = str_find(upper, ch)
    if u_pos >= 0 { deliver u_pos + 10 }
    deliver 0
}

flow pq_hex_byte(hex_str: Text, byte_offset: Int) -> Int {
    flex idx = byte_offset * 2
    flex d0 = pq_hex_digit(hex_str, idx)
    flex d1 = pq_hex_digit(hex_str, idx + 1)
    deliver (d0 * 16) + d1
}

open flow pq_read_u32_le(hex_str: Text, byte_offset: Int) -> Int {
    flex b0 = pq_hex_byte(hex_str, byte_offset)
    flex b1 = pq_hex_byte(hex_str, byte_offset + 1)
    flex b2 = pq_hex_byte(hex_str, byte_offset + 2)
    flex b3 = pq_hex_byte(hex_str, byte_offset + 3)
    deliver b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216)
}

// Verifies 'PAR1' magic at start and end of file
// 'P' = 0x50, 'A' = 0x41, 'R' = 0x52, '1' = 0x31 -> hex: "50415231"
open flow parquet_verify_file_magic(file_hex: Text) -> Bool {
    flex hex_len = length(file_hex)
    if hex_len < 16 { deliver false } // at least 8 bytes

    flex head_magic = str_slice(file_hex, 0, 8)
    if !constant_time_compare(head_magic, "50415231") { deliver false }

    flex tail_magic = str_slice(file_hex, hex_len - 8, 8)
    if !constant_time_compare(tail_magic, "50415231") { deliver false }

    deliver true
}

// Extracts 4-byte little-endian footer metadata length preceding the trailing 'PAR1'
open flow parquet_get_footer_len(file_hex: Text) -> Int {
    flex hex_len = length(file_hex)
    if hex_len < 16 { deliver 0 - 1 }
    flex total_bytes = hex_len / 2
    // Trailing 4 bytes: PAR1 (total_bytes - 4)
    // Preceding 4 bytes: footer_len (total_bytes - 8)
    flex len_offset = total_bytes - 8
    deliver pq_read_u32_le(file_hex, len_offset)
}

// ============================================================================
// PARQUET METADATA BUFFER LAYOUT (48 bytes)
// [0..8]:   version
// [8..16]:  num_rows
// [16..24]: num_row_groups
// [24..32]: num_columns
// [32..40]: is_valid (1 or 0)
// [40..48]: footer_len
// ============================================================================

open flow parquet_parse_footer(file_hex: Text) -> Int {
    flex meta = alloc_buffer(48)
    mem_fill(meta, 0, 48)

    if !parquet_verify_file_magic(file_hex) {
        mem_write_i64(meta, 32, 0) // is_valid = 0
        deliver meta
    }

    flex total_bytes = length(file_hex) / 2
    flex footer_len = parquet_get_footer_len(file_hex)
    if footer_len <= 0 || footer_len > (total_bytes - 8) {
        mem_write_i64(meta, 32, 0)
        deliver meta
    }

    flex footer_start = total_bytes - 8 - footer_len
    // Decodes synthetic parquet metadata descriptor:
    // [0..4]: version (u32 LE)
    // [4..8]: num_rows (u32 LE)
    // [8..12]: num_row_groups (u32 LE)
    // [12..16]: num_columns (u32 LE)
    flex ver = pq_read_u32_le(file_hex, footer_start)
    flex rows = pq_read_u32_le(file_hex, footer_start + 4)
    flex rgroups = pq_read_u32_le(file_hex, footer_start + 8)
    flex cols = pq_read_u32_le(file_hex, footer_start + 12)

    mem_write_i64(meta, 0, ver)
    mem_write_i64(meta, 8, rows)
    mem_write_i64(meta, 16, rgroups)
    mem_write_i64(meta, 24, cols)
    mem_write_i64(meta, 32, 1) // is_valid = 1
    mem_write_i64(meta, 40, footer_len)

    deliver meta
}

open flow parquet_meta_version(meta: Int) -> Int { deliver mem_read_i64(meta, 0) }
open flow parquet_meta_num_rows(meta: Int) -> Int { deliver mem_read_i64(meta, 8) }
open flow parquet_meta_num_row_groups(meta: Int) -> Int { deliver mem_read_i64(meta, 16) }
open flow parquet_meta_num_columns(meta: Int) -> Int { deliver mem_read_i64(meta, 24) }
open flow parquet_meta_is_valid(meta: Int) -> Bool { deliver mem_read_i64(meta, 32) == 1 }
open flow parquet_meta_footer_len(meta: Int) -> Int { deliver mem_read_i64(meta, 40) }

open flow parquet_meta_free(meta: Int) -> Int {
    if meta != 0 { free_buffer(meta) }
    deliver 0
}
