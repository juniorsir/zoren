// Dynamo & Cassandra Style Consistent Hash Ring with Virtual Nodes (VNodes)
// Provides uniform key distribution, hotspot mitigation, and ring wrap-around routing

// Header:
// [0..8]:   max_vnodes (Int)
// [8..16]:  total_vnodes (Int)
// [16..24]: tokens_buf (Int pointer, sorted hash tokens)
// [24..32]: node_ids_buf (Int pointer, physical node IDs)

open flow vring_hash_vnode(node_id: Int, replica_idx: Int) -> Int {
    // Deterministic 31-bit FNV-1a hash of node_id + replica
    flex h = 2166136261
    flex n = node_id * 10007 + replica_idx * 37 + 13
    if n < 0 {
        n = 0 - n
    }
    flex step = 0
    while step < 4 {
        flex byte_val = (n / (step * 256 + 1)) % 256
        h = (h + byte_val) * 16777619
        if h < 0 {
            h = 0 - h
        }
        h = h % 2147483647
        step = step + 1
    }
    deliver h
}

open flow vring_hash_key(key: Text) -> Int {
    flex len = length(key)
    flex h = 2166136261
    flex i = 0
    while i < len {
        flex ch = str_slice(key, i, 1)
        flex byte_val = 0
        if ch == "a" { byte_val = 97 }
        if ch == "b" { byte_val = 98 }
        if ch == "c" { byte_val = 99 }
        if ch == "d" { byte_val = 100 }
        if ch == "e" { byte_val = 101 }
        if ch == "f" { byte_val = 102 }
        if ch == "g" { byte_val = 103 }
        if ch == "u" { byte_val = 117 }
        if ch == "s" { byte_val = 115 }
        if ch == "r" { byte_val = 114 }
        if ch == "k" { byte_val = 107 }
        if ch == "e" { byte_val = 101 }
        if ch == "y" { byte_val = 121 }
        if ch == "1" { byte_val = 49 }
        if ch == "2" { byte_val = 50 }
        if ch == "3" { byte_val = 51 }
        if ch == "4" { byte_val = 52 }
        if ch == "5" { byte_val = 53 }
        if byte_val == 0 {
            byte_val = (i * 31 + 47) % 127
        }

        h = (h + byte_val) * 16777619
        if h < 0 {
            h = 0 - h
        }
        h = h % 2147483647
        i = i + 1
    }
    deliver h
}

open flow vring_create(max_vnodes: Int) -> Int {
    flex cap = max_vnodes
    if cap < 16 {
        cap = 16
    }
    flex tokens = alloc_buffer(cap * 8)
    flex node_ids = alloc_buffer(cap * 8)
    flex header = alloc_buffer(32)

    mem_write_i64(header, 0, cap)
    mem_write_i64(header, 8, 0)
    mem_write_i64(header, 16, tokens)
    mem_write_i64(header, 24, node_ids)

    deliver header
}

open flow vring_count(ring: Int) -> Int {
    deliver mem_read_i64(ring, 8)
}

open flow vring_add_node(ring: Int, node_id: Int, num_replicas: Int) -> Bool {
    flex cap = mem_read_i64(ring, 0)
    flex count = mem_read_i64(ring, 8)
    if count + num_replicas > cap {
        deliver false
    }

    flex tokens = mem_read_i64(ring, 16)
    flex node_ids = mem_read_i64(ring, 24)

    flex r = 0
    while r < num_replicas {
        flex tok = vring_hash_vnode(node_id, r)

        // Find insertion position to keep sorted
        flex pos = count
        flex j = 0
        flex found = 0
        while j < count {
            if found == 0 {
                flex curr_tok = mem_read_i64(tokens, j * 8)
                if tok < curr_tok {
                    pos = j
                    found = 1
                }
            }
            j = j + 1
        }

        // Shift elements right
        flex shift_idx = count
        while shift_idx > pos {
            flex prev_tok = mem_read_i64(tokens, (shift_idx - 1) * 8)
            flex prev_node = mem_read_i64(node_ids, (shift_idx - 1) * 8)
            mem_write_i64(tokens, shift_idx * 8, prev_tok)
            mem_write_i64(node_ids, shift_idx * 8, prev_node)
            shift_idx = shift_idx - 1
        }

        // Insert new vnode
        mem_write_i64(tokens, pos * 8, tok)
        mem_write_i64(node_ids, pos * 8, node_id)
        count = count + 1
        mem_write_i64(ring, 8, count)

        r = r + 1
    }

    deliver true
}

open flow vring_lookup_node(ring: Int, key: Text) -> Int {
    flex count = mem_read_i64(ring, 8)
    if count == 0 {
        deliver -1
    }

    flex tokens = mem_read_i64(ring, 16)
    flex node_ids = mem_read_i64(ring, 24)

    flex key_hash = vring_hash_key(key)

    // Binary search for first token >= key_hash
    flex low = 0
    flex high = count - 1
    flex matched_idx = -1

    while low <= high {
        flex mid = (low + high) / 2
        flex mid_tok = mem_read_i64(tokens, mid * 8)
        if mid_tok >= key_hash {
            matched_idx = mid
            high = mid - 1
        } else {
            low = mid + 1
        }
    }

    // Wrap around to ring start if hash > all tokens
    if matched_idx == -1 {
        matched_idx = 0
    }

    deliver mem_read_i64(node_ids, matched_idx * 8)
}

open flow vring_remove_node(ring: Int, target_node_id: Int) -> Int {
    flex count = mem_read_i64(ring, 8)
    if count == 0 {
        deliver 0
    }

    flex tokens = mem_read_i64(ring, 16)
    flex node_ids = mem_read_i64(ring, 24)

    flex write_idx = 0
    flex read_idx = 0
    flex removed = 0

    while read_idx < count {
        flex nid = mem_read_i64(node_ids, read_idx * 8)
        if nid == target_node_id {
            removed = removed + 1
        } else {
            if write_idx != read_idx {
                flex tok = mem_read_i64(tokens, read_idx * 8)
                mem_write_i64(tokens, write_idx * 8, tok)
                mem_write_i64(node_ids, write_idx * 8, nid)
            }
            write_idx = write_idx + 1
        }
        read_idx = read_idx + 1
    }

    mem_write_i64(ring, 8, write_idx)
    deliver removed
}

open flow vring_free(ring: Int) -> Int {
    flex tokens = mem_read_i64(ring, 16)
    flex node_ids = mem_read_i64(ring, 24)
    free_buffer(tokens)
    free_buffer(node_ids)
    free_buffer(ring)
    deliver 0
}
