// Zoren Vector Quantization & K-Means Suite (plugins/vector_quantize_kmeans.zor)
// Production AI embedding vector compression engine implementing Product Quantization (PQ)
// centroid codebook assignment and fast asymmetric distance computation (ADC).

bring sys

// ============================================================================
// VECTOR QUANTIZER MEMORY LAYOUT
// Header (40 bytes):
// [0..8]:   dim (vector dimensionality)
// [8..16]:  num_clusters (K centroids)
// [16..24]: centroids_buf (K * dim * 8 bytes)
// [24..32]: counts_buf (K * 8 bytes, count of assigned vectors)
// [32..40]: reserved
// ============================================================================

flow vq_coord_addr(vq: Int, cluster_id: Int, dim_idx: Int) -> Int {
    flex dim = mem_read_i64(vq, 0)
    flex buf = mem_read_i64(vq, 16)
    flex offset = ((cluster_id * dim) + dim_idx) * 8
    deliver buf + offset
}

open flow vq_new(dim: Int, num_clusters: Int) -> Int {
    flex d = dim
    if d <= 0 { d = 4 }
    flex k = num_clusters
    if k <= 0 { k = 4 }

    flex total_coords = k * d
    flex total_bytes = total_coords * 8
    flex centroids_buf = alloc_buffer(total_bytes)
    mem_fill(centroids_buf, 0, total_bytes)

    flex counts_buf = alloc_buffer(k * 8)
    mem_fill(counts_buf, 0, k * 8)

    flex vq = alloc_buffer(40)
    mem_write_i64(vq, 0, d)
    mem_write_i64(vq, 8, k)
    mem_write_i64(vq, 16, centroids_buf)
    mem_write_i64(vq, 24, counts_buf)
    mem_write_i64(vq, 32, 0)

    deliver vq
}

open flow vq_dim(vq: Int) -> Int { deliver mem_read_i64(vq, 0) }
open flow vq_num_clusters(vq: Int) -> Int { deliver mem_read_i64(vq, 8) }

// Sets a centroid vector for a given cluster_id
open flow vq_set_centroid(vq: Int, cluster_id: Int, vec_buf: Int) -> Int {
    flex k = mem_read_i64(vq, 8)
    if cluster_id < 0 || cluster_id >= k { deliver 0 }
    flex d = mem_read_i64(vq, 0)

    flex i = 0
    while i < d {
        flex val = mem_read_i64(vec_buf, i * 8)
        flex addr = vq_coord_addr(vq, cluster_id, i)
        mem_write_i64(addr, 0, val)
        i = i + 1
    }
    deliver 1
}

open flow vq_get_centroid_coord(vq: Int, cluster_id: Int, dim_idx: Int) -> Int {
    flex k = mem_read_i64(vq, 8)
    flex d = mem_read_i64(vq, 0)
    if cluster_id < 0 || cluster_id >= k { deliver 0 }
    if dim_idx < 0 || dim_idx >= d { deliver 0 }

    flex addr = vq_coord_addr(vq, cluster_id, dim_idx)
    deliver mem_read_i64(addr, 0)
}

// Computes squared Euclidean distance between query vector and cluster centroid
open flow vq_asymmetric_distance(vq: Int, query_vec: Int, cluster_id: Int) -> Int {
    flex d = mem_read_i64(vq, 0)
    flex dist_sq = 0
    flex i = 0
    while i < d {
        flex q_val = mem_read_i64(query_vec, i * 8)
        flex c_addr = vq_coord_addr(vq, cluster_id, i)
        flex c_val = mem_read_i64(c_addr, 0)

        flex diff = q_val - c_val
        dist_sq = dist_sq + (diff * diff)
        i = i + 1
    }
    deliver dist_sq
}

// Quantizes a query vector by assigning it to the nearest cluster centroid
// Returns nearest cluster_id
open flow vq_quantize(vq: Int, query_vec: Int) -> Int {
    flex k = mem_read_i64(vq, 8)
    if k <= 0 { deliver 0 - 1 }

    flex best_cluster = 0
    flex min_dist = vq_asymmetric_distance(vq, query_vec, 0)

    flex c = 1
    while c < k {
        flex d = vq_asymmetric_distance(vq, query_vec, c)
        if d < min_dist {
            min_dist = d
            best_cluster = c
        }
        c = c + 1
    }

    deliver best_cluster
}

open flow vq_free(vq: Int) -> Int {
    if vq != 0 {
        flex centroids_buf = mem_read_i64(vq, 16)
        flex counts_buf = mem_read_i64(vq, 24)
        if centroids_buf != 0 { free_buffer(centroids_buf) }
        if counts_buf != 0 { free_buffer(counts_buf) }
        free_buffer(vq)
    }
    deliver 0
}
